{
  "name": "yt-data",
  "version": "0.3.0",
  "description": "Agent-friendly CLI to fetch YouTube channel/video metadata, transcripts, thumbnails and downloads",
  "private": true,
  "type": "module",
  "bin": {
    "yt-data": "src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --compile --minify --outfile dist/yt-data",
    "build:all": "bun run scripts/build-all.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "engines": {
    "bun": ">=1.4"
  },
  "dependencies": {
    "@opentui/core": "^0.5.14",
    "@opentui/react": "^0.5.14",
    "commander": "^15.0.0",
    "react": "^19.3.0",
    "youtubei.js": "^18.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
